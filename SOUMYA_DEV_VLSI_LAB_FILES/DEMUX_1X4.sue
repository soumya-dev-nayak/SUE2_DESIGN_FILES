proc SCHEMATIC_DEMUX_1X4 {} {
make DEMUX_1x2 -name xi0 -origin {-200 150}
make DEMUX_1x2 -name xi1 -origin {250 -10}
make output -name I0 -origin {530 -30}
make output -name I1 -origin {530 -10}
make output -name I2 -origin {530 280}
make output -name I3 -origin {530 300}
make inout -name a_Vdd -origin {240 -270}
make inout -name a_Gnd -origin {240 540}
make input -name Y -origin {-350 130}
make DEMUX_1x2 -name xi2 -origin {250 300}
make input -name S1 -origin {-350 150}
make input -name S0 -origin {100 130}
  make_wire -100 130 0 130
  make_wire 0 -30 150 -30
  make_wire -100 150 0 150
  make_wire 0 280 150 280
  make_wire 0 -30 0 130
  make_wire 0 150 0 280
  make_wire 470 -220 470 30
  make_wire -60 -220 -60 190
  make_wire -60 190 -100 190
  make_wire -100 210 -60 210
  make_wire -60 210 -60 460
  make_wire 470 460 470 360
  make_wire 470 360 350 360
  make_wire 350 50 470 50
  make_wire 470 50 470 360
  make_wire 350 340 400 340
  make_wire 400 340 400 30
  make_wire 400 30 350 30
  make_wire 400 30 470 30
  make_wire 350 -30 530 -30
  make_wire 350 -10 530 -10
  make_wire 350 280 530 280
  make_wire 350 300 530 300
  make_wire 240 -220 470 -220
  make_wire 240 -220 -60 -220
  make_wire 240 460 -60 460
  make_wire 240 460 470 460
  make_wire -300 130 -350 130
  make_wire -300 150 -350 150
  make_wire 240 -270 240 -220
  make_wire 240 460 240 540
  make_wire 150 -10 100 -10
  make_wire 100 300 150 300
  make_wire 100 -10 100 130
  make_wire 100 130 100 300
}

proc ICON_DEMUX_1X4 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -40} -name Y
icon_term -type input -origin {-100 -20} -name S1
icon_term -type input -origin {-100 0} -name S0
icon_term -type output -origin {100 -40} -name I0
icon_term -type output -origin {100 -20} -name I1
icon_term -type output -origin {100 0} -name I2
icon_term -type output -origin {100 20} -name I3
icon_term -type inout -origin {100 60} -name a_Vdd
icon_term -type inout -origin {100 80} -name a_Gnd
icon_property -origin {-90 -40} -label Y
icon_property -origin {-90 -20} -label S1
icon_property -origin {-90 0} -label S0
icon_property -origin {90 -40} -anchor e -label I0
icon_property -origin {90 -20} -anchor e -label I1
icon_property -origin {90 0} -anchor e -label I2
icon_property -origin {90 20} -anchor e -label I3
icon_property -origin {90 60} -anchor e -label a_Vdd
icon_property -origin {90 80} -anchor e -label a_Gnd
icon_property -origin {-90 -90} -label {$name}
icon_property -origin {-90 -70} -label DEMUX_1X4
  icon_line -100 -80 100 -80 100 100 -100 100 -100 -80
icon_property -origin {-90 110} -label {example_param=$example_param}
  icon_property -origin {-90 170} -type user -name name -default x
  icon_property -origin {-90 190} -type user -name example_param -default 1.0
}


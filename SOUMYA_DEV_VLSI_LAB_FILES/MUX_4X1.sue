proc SCHEMATIC_MUX_4X1 {} {
make CMOS_2X1_MUX -name xi0 -origin {-1340 -1560}
make CMOS_2X1_MUX -name xi1 -origin {-1340 -1310}
make CMOS_2X1_MUX -name xi2 -origin {-950 -1470}
make input -name S0 -origin {-1730 -1570}
make input -name S1 -origin {-1740 -1480}
make inout -name a_Vdd -origin {-1170 -1790}
make inout -name a_Gnd -origin {-1210 -1720}
make output -name Y -origin {-760 -1480}
make input -name I0 -origin {-1440 -1550}
make input -name I1 -origin {-1440 -1530}
make input -name I2 -origin {-1440 -1300}
make input -name I3 -origin {-1440 -1280}
  make_wire -1240 -1320 -1140 -1320
  make_wire -1140 -1440 -1050 -1440
  make_wire -1240 -1570 -1140 -1570
  make_wire -1140 -1460 -1050 -1460
  make_wire -1140 -1570 -1140 -1460
  make_wire -1560 -1680 -1560 -1140
  make_wire -1630 -1740 -1630 -1060
  make_wire -1210 -1680 -1560 -1680
  make_wire -1240 -1530 -1210 -1530
  make_wire -1210 -1530 -1210 -1680
  make_wire -1240 -1510 -1170 -1510
  make_wire -1170 -1510 -1170 -1740
  make_wire -1170 -1740 -1630 -1740
  make_wire -1240 -1260 -1200 -1260
  make_wire -1200 -1260 -1200 -1060
  make_wire -1200 -1060 -1630 -1060
  make_wire -1240 -1280 -1170 -1280
  make_wire -1170 -1280 -1170 -1140
  make_wire -1170 -1140 -1560 -1140
  make_wire -1170 -1140 -810 -1140
  make_wire -850 -1420 -770 -1420
  make_wire -770 -1420 -770 -1060
  make_wire -770 -1060 -1200 -1060
  make_wire -850 -1440 -810 -1440
  make_wire -810 -1440 -810 -1140
  make_wire -1140 -1320 -1140 -1440
  make_wire -1510 -1570 -1510 -1320
  make_wire -1510 -1320 -1440 -1320
  make_wire -1510 -1570 -1440 -1570
  make_wire -1510 -1570 -1730 -1570
  make_wire -1050 -1480 -1740 -1480
  make_wire -1170 -1790 -1170 -1740
  make_wire -1210 -1680 -1210 -1720
  make_wire -850 -1480 -760 -1480
}

proc ICON_MUX_4X1 args {

  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -40} -name S0
icon_term -type input -origin {-100 -20} -name S1
icon_term -type input -origin {-100 0} -name I0
icon_term -type input -origin {-100 20} -name I1
icon_term -type input -origin {-100 40} -name I2
icon_term -type input -origin {-100 60} -name I3
icon_term -type output -origin {100 -40} -name Y
icon_term -type inout -origin {100 0} -name a_Vdd
icon_term -type inout -origin {100 20} -name a_Gnd
icon_property -origin {-90 -40} -label S0
icon_property -origin {-90 -20} -label S1
icon_property -origin {-90 0} -label I0
icon_property -origin {-90 20} -label I1
icon_property -origin {-90 40} -label I2
icon_property -origin {-90 60} -label I3
icon_property -origin {90 -40} -anchor e -label Y
icon_property -origin {90 0} -anchor e -label a_Vdd
icon_property -origin {90 20} -anchor e -label a_Gnd
icon_property -origin {-90 -90} -label {$name}
icon_property -origin {-90 -70} -label MUX_4X1
  icon_line -100 -80 100 -80 100 80 -100 80 -100 -80
icon_property -origin {-90 90} -label {example_param=$example_param}
  icon_property -origin {-90 150} -type user -name name -default x
  icon_property -origin {-90 170} -type user -name example_param -default 1.0

}


proc SCHEMATIC_test_new_2X1_MUX {} {
make MUX_2X1 -name xi0 -origin {-10 40}
make global -name Gnd -origin {190 240}
make global -name Vdd -origin {120 120}
make input -name s -origin {-420 10}
make input -name i0 -origin {-290 50}
make input -name i1 -origin {-170 70}
make output -name y -origin {90 30}
make pulse -name V0 -pulse_voltage 1.3V -origin {-420 50}
make pulse -name V1 -pulse_voltage 1.3V -pulse_width 4ns -period 8ns -origin {-290 90}
make pulse -name V2 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {-170 110}
  make_wire 120 90 120 120
  make_wire 90 90 120 90
  make_wire 90 70 190 70
  make_wire -110 10 -420 10
  make_wire -110 10 -110 30
  make_wire -110 50 -290 50
  make_wire -110 70 -170 70
  make_wire -170 150 -170 220
  make_wire -170 220 190 220
  make_wire 190 220 190 70
  make_wire 190 220 190 240
  make_wire -290 130 -290 220
  make_wire -290 220 -170 220
  make_wire -420 90 -420 220
  make_wire -420 220 -290 220
}


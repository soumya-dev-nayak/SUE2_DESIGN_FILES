icon_term -type output -origin {100 -30} -name S6
icon_term -type output -origin {100 -10} -name S7
icon_term -type output -origin {100 10} -name Cout
icon_term -type inout -origin {100 50} -name a_Vdd
icon_term -type inout -origin {100 70} -name a_Gnd
icon_property -origin {-90 -150} -label A0
icon_property -origin {-90 -130} -label B0
icon_property -origin {-90 -110} -label Cin
icon_property -origin {-90 -90} -label A1
icon_property -origin {-90 -70} -label B1
icon_property -origin {-90 -50} -label A2
icon_property -origin {-90 -30} -label B2
icon_property -origin {-90 -10} -label A3
icon_property -origin {-90 10} -label B3
icon_property -origin {-90 30} -label A4
icon_property -origin {-90 50} -label B4
icon_property -origin {-90 70} -label A7
icon_property -origin {-90 90} -label B7
icon_property -origin {-90 110} -label A6
icon_property -origin {-90 130} -label B6
icon_property -origin {-90 150} -label A5
icon_property -origin {-90 170} -label B5
icon_property -origin {90 -150} -anchor e -label S0
icon_property -origin {90 -130} -anchor e -label S1
icon_property -origin {90 -110} -anchor e -label S2
icon_property -origin {90 -90} -anchor e -label S3
icon_property -origin {90 -70} -anchor e -label S4
icon_property -origin {90 -50} -anchor e -label S5
icon_property -origin {90 -30} -anchor e -label S6
icon_property -origin {90 -10} -anchor e -label S7
icon_property -origin {90 10} -anchor e -label Cout
icon_property -origin {90 50} -anchor e -label a_Vdd
icon_property -origin {90 70} -anchor e -label a_Gnd
icon_property -origin {-90 -200} -label {$name}
icon_property -origin {-90 -180} -label _8_BIT_ADDER
  icon_line -100 -190 100 -190 100 190 -100 190 -100 -190
icon_property -origin {-90 200} -label {example_param=$example_param}
  icon_property -origin {-90 260} -type user -name name -default x
  icon_property -origin {-90 280} -type user -name example_param -default 1.0


}


proc SCHEMATIC_MyVLSITest {} {
make input -name b -origin {-440 -10}
make global -name gnd -origin {440 260}
make input -name a -origin {-350 10}
make input -name c -origin {-250 30}
make input -name d -origin {-140 50}
make input -name e -origin {-50 70}
make input -name f -origin {40 90}
make global -name vdd -origin {500 80}
make output -name y -origin {340 -10}
make Test_1 -name xi0 -origin {240 30}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 4ns -period 8ns -origin {-440 30}
make pulse -name V1 -pulse_voltage 1.3V -origin {-350 50}
make pulse -name V2 -pulse_voltage 1.3V -pulse_width 5ns -period 10ns -origin {-250 70}
make pulse -name V3 -pulse_voltage 1.3V -pulse_width 6ns -period 12ns -origin {-140 90}
make pulse -name V4 -pulse_voltage 1.3V -pulse_width 7ns -period 14ns -origin {-50 110}
make pulse -name V5 -pulse_voltage 1.3V -pulse_width 8ns -period 16ns -origin {40 130}
  make_wire 140 70 -50 70
  make_wire 140 -10 -440 -10
  make_wire 140 50 -140 50
  make_wire -350 10 140 10
  make_wire -250 30 140 30
  make_wire 40 90 140 90
  make_wire 340 50 440 50
  make_wire -440 70 -440 240
  make_wire 440 240 440 50
  make_wire 440 240 440 260
  make_wire 40 170 40 240
  make_wire 40 240 440 240
  make_wire -50 150 -50 240
  make_wire -50 240 40 240
  make_wire -140 130 -140 240
  make_wire -140 240 -50 240
  make_wire -250 110 -250 240
  make_wire -250 240 -140 240
  make_wire -350 90 -350 240
  make_wire -350 240 -250 240
  make_wire -350 240 -440 240
  make_wire 340 30 500 30
  make_wire 500 30 500 80
}


proc SCHEMATIC_test_SR_Flip_Flop {} {
make input -name clk -origin {290 0}
make input -name r -origin {-20 -40}
make input -name s -origin {140 -20}
make global -name vdd -origin {620 80}
make global -name gnd -origin {700 230}
make output -name q -origin {600 -40}
make output -name ~q -origin {600 -20}
make SR_Flip_Flop -name xi0 -origin {500 -20}
make pulse -name V0 -pulse_voltage 1.3V -pulse_width 12ns -period 24ns -origin {-20 0}
make pulse -name V1 -pulse_voltage 1.3V -pulse_width 6ns -period 12ns -origin {140 20}
make pulse -name V2 -pulse_voltage 1.3V -origin {290 40}
  make_wire 400 -20 140 -20
  make_wire 400 0 290 0
  make_wire -20 -40 400 -40
  make_wire 600 40 620 40
  make_wire 600 20 700 20
  make_wire -20 40 -20 220
  make_wire 700 220 700 20
  make_wire 700 220 700 230
  make_wire 290 80 290 220
  make_wire 290 220 700 220
  make_wire 140 60 140 220
  make_wire -20 220 140 220
  make_wire 140 220 290 220
  make_wire 620 40 620 80
}


proc SCHEMATIC_my_SUBTRACTOR {} {
make CMOS_HALF_SUBTRACTOR -name xi0 -origin {-1590 -900}
make CMOS_HALF_SUBTRACTOR -name xi1 -origin {-1180 -900}
make input -name X -origin {-1750 -930}
make input -name Y -origin {-1750 -880}
make input -name Bin -origin {-1320 -900}
make inout -name a_Gnd -origin {-1450 -480}
make inout -name a_Vdd -origin {-1450 -1130}
make CMOS_OR_GATE -name xi2 -origin {-840 -680}
make output -name Diff -origin {-650 -920}
make output -name Bout -origin {-670 -690}
  make_wire -1690 -880 -1750 -880
  make_wire -1690 -930 -1750 -930
  make_wire -1490 -840 -1450 -840
  make_wire -1450 -860 -1490 -860
  make_wire -1490 -920 -1280 -920
  make_wire -1280 -900 -1320 -900
  make_wire -1490 -900 -1390 -900
  make_wire -1390 -670 -940 -670
  make_wire -1080 -860 -1040 -860
  make_wire -1040 -860 -1040 -1040
  make_wire -1450 -1040 -1450 -860
  make_wire -1450 -1040 -1450 -1130
  make_wire -1080 -840 -1070 -840
  make_wire -1070 -840 -1070 -560
  make_wire -1070 -560 -1450 -560
  make_wire -1450 -560 -1450 -840
  make_wire -1450 -560 -1450 -480
  make_wire -1080 -900 -960 -900
  make_wire -960 -690 -940 -690
  make_wire -960 -900 -960 -690
  make_wire -1390 -900 -1390 -670
  make_wire -740 -690 -670 -690
  make_wire -740 -630 -700 -630
  make_wire -700 -630 -700 -560
  make_wire -700 -560 -1070 -560
  make_wire -720 -650 -720 -1040
  make_wire -1080 -920 -650 -920
  make_wire -1450 -1040 -1040 -1040
  make_wire -1040 -1040 -720 -1040
  make_wire -740 -650 -720 -650
  make_wire -1690 -930 -1690 -920
  make_wire -1690 -900 -1690 -880
}

proc ICON_my_SUBTRACTOR args {

  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -20} -name X
icon_term -type input -origin {-100 0} -name Y
icon_term -type input -origin {-100 20} -name Bin
icon_term -type output -origin {100 -20} -name Diff
icon_term -type output -origin {100 0} -name Bout
icon_term -type inout -origin {100 40} -name a_Gnd
icon_term -type inout -origin {100 60} -name a_Vdd
icon_property -origin {-90 -20} -label X
icon_property -origin {-90 0} -label Y
icon_property -origin {-90 20} -label Bin
icon_property -origin {90 -20} -anchor e -label Diff
icon_property -origin {90 0} -anchor e -label Bout
icon_property -origin {90 40} -anchor e -label a_Gnd
icon_property -origin {90 60} -anchor e -label a_Vdd
icon_property -origin {-90 -70} -label {$name}
icon_property -origin {-90 -50} -label my_SUBTRACTOR
  icon_line -100 -60 100 -60 100 80 -100 80 -100 -60
icon_property -origin {-90 90} -label {example_param=$example_param}
  icon_property -origin {-90 150} -type user -name name -default x
  icon_property -origin {-90 170} -type user -name example_param -default 1.0

}


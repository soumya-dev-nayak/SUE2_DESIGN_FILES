proc ICON_First_Boolean_Function args {

  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -50} -name A
icon_term -type input -origin {-100 -30} -name B
icon_term -type input -origin {-100 -10} -name G
icon_term -type input -origin {-100 10} -name C
icon_term -type input -origin {-100 30} -name D
icon_term -type input -origin {-100 50} -name E
icon_term -type input -origin {-100 70} -name F
icon_term -type output -origin {100 -50} -name Y
icon_term -type inout -origin {100 -10} -name a_Gnd
icon_term -type inout -origin {100 10} -name a_Vdd
icon_property -origin {-90 -50} -label A
icon_property -origin {-90 -30} -label B
icon_property -origin {-90 -10} -label G
icon_property -origin {-90 10} -label C
icon_property -origin {-90 30} -label D
icon_property -origin {-90 50} -label E
icon_property -origin {-90 70} -label F
icon_property -origin {90 -50} -anchor e -label Y
icon_property -origin {90 -10} -anchor e -label a_Gnd
icon_property -origin {90 10} -anchor e -label a_Vdd
icon_property -origin {-90 -100} -label {$name}
  icon_line -100 -90 100 -90 100 90 -100 90 -100 -90
icon_property -origin {-90 100} -label {example_param=$example_param}
  icon_property -origin {-90 160} -type user -name name -default x
  icon_property -origin {-90 180} -type user -name example_param -default 1.0
icon_property -origin {-90 -80} -label Boolean_bar((AB+CD)G+EF)

}


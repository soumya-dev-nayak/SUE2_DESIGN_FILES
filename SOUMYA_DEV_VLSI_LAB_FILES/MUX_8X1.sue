proc SCHEMATIC_MUX_8X1 {} {
make MUX_4X1 -name xi0 -origin {-1390 -1440}
make MUX_4X1 -name xi1 -origin {-1380 -1120}
make MUX_2X1 -name xi2 -origin {-1030 -1300}
make input -name S0 -origin {-1870 -1480}
make input -name S1 -origin {-1870 -1460}
make input -name S2 -origin {-1870 -1310}
make output -name Y -origin {-840 -1310}
make input -name I0 -origin {-1490 -1440}
make input -name I1 -origin {-1490 -1420}
make input -name I2 -origin {-1490 -1400}
make input -name I3 -origin {-1490 -1380}
make input -name I4 -origin {-1480 -1120}
make input -name I5 -origin {-1480 -1100}
make input -name I6 -origin {-1480 -1080}
make input -name I7 -origin {-1480 -1060}
make inout -name a_Vdd -origin {-1270 -1700}
make inout -name a_Gnd -origin {-1230 -1650}
  make_wire -1290 -1480 -1210 -1480
  make_wire -1210 -1290 -1130 -1290
  make_wire -1280 -1160 -1210 -1160
  make_wire -1210 -1270 -1130 -1270
  make_wire -1210 -1480 -1210 -1290
  make_wire -1210 -1270 -1210 -1160
  make_wire -930 -1250 -910 -1250
  make_wire -1280 -1120 -1220 -1120
  make_wire -1220 -1120 -1220 -890
  make_wire -1220 -890 -910 -890
  make_wire -1220 -890 -1770 -890
  make_wire -1290 -1440 -1270 -1440
  make_wire -1270 -1440 -1270 -1660
  make_wire -1270 -1660 -1770 -1660
  make_wire -1290 -1420 -1230 -1420
  make_wire -1230 -1420 -1230 -1600
  make_wire -1230 -1600 -1700 -1600
  make_wire -1560 -1160 -1480 -1160
  make_wire -1560 -1480 -1490 -1480
  make_wire -1560 -1480 -1870 -1480
  make_wire -1600 -1140 -1480 -1140
  make_wire -1600 -1460 -1490 -1460
  make_wire -1600 -1460 -1870 -1460
  make_wire -1130 -1310 -1870 -1310
  make_wire -1600 -1460 -1600 -1140
  make_wire -1560 -1480 -1560 -1160
  make_wire -1700 -1600 -1700 -950
  make_wire -1770 -1660 -1770 -890
  make_wire -910 -1250 -910 -890
  make_wire -930 -1270 -860 -1270
  make_wire -860 -1270 -860 -950
  make_wire -930 -1310 -840 -1310
  make_wire -1280 -1100 -1260 -1100
  make_wire -1260 -1100 -1260 -950
  make_wire -1260 -950 -860 -950
  make_wire -1260 -950 -1700 -950
  make_wire -1270 -1700 -1270 -1660
  make_wire -1230 -1600 -1230 -1650
}

proc ICON_MUX_8X1 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -90} -name S0
icon_term -type input -origin {-100 -70} -name S1
icon_term -type input -origin {-100 -50} -name S2
icon_term -type input -origin {-100 -30} -name I0
icon_term -type input -origin {-100 -10} -name I1
icon_term -type input -origin {-100 10} -name I2
icon_term -type input -origin {-100 30} -name I3
icon_term -type input -origin {-100 50} -name I4
icon_term -type input -origin {-100 70} -name I5
icon_term -type input -origin {-100 90} -name I6
icon_term -type input -origin {-100 110} -name I7
icon_term -type output -origin {100 -90} -name Y
icon_term -type inout -origin {100 -50} -name a_Vdd
icon_term -type inout -origin {100 -30} -name a_Gnd
icon_property -origin {-90 -90} -label S0
icon_property -origin {-90 -70} -label S1
icon_property -origin {-90 -50} -label S2
icon_property -origin {-90 -30} -label I0
icon_property -origin {-90 -10} -label I1
icon_property -origin {-90 10} -label I2
icon_property -origin {-90 30} -label I3
icon_property -origin {-90 50} -label I4
icon_property -origin {-90 70} -label I5
icon_property -origin {-90 90} -label I6
icon_property -origin {-90 110} -label I7
icon_property -origin {90 -90} -anchor e -label Y
icon_property -origin {90 -50} -anchor e -label a_Vdd
icon_property -origin {90 -30} -anchor e -label a_Gnd
icon_property -origin {-90 -140} -label {$name}
icon_property -origin {-90 -120} -label MUX_8X1
  icon_line -100 -130 100 -130 100 130 -100 130 -100 -130
icon_property -origin {-90 140} -label {example_param=$example_param}
  icon_property -origin {-90 200} -type user -name name -default x
  icon_property -origin {-90 220} -type user -name example_param -default 1.0
}


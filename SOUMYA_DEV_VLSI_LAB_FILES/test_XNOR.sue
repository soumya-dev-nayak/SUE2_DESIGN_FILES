proc SCHEMATIC_test_XNOR {} {
make CMOS_XNOR -name xi0 -origin {10 120}
make global -name Gnd -origin {140 310}
make global -name Vdd -origin {200 220}
make output -name Out -origin {210 110}
make input -name A -origin {-190 100}
make input -name B -origin {-190 150}
make pulse -orient RXY -name V0 -origin {-160 60}
make pulse -name V1 -pulse_width 2ns -period 4ns -origin {-160 190}
  make_wire 110 170 140 170
  make_wire 110 150 200 150
  make_wire 200 150 200 220
  make_wire 140 170 140 310
  make_wire 110 110 210 110
  make_wire -90 130 -90 150
  make_wire -90 100 -90 110
  make_wire -160 150 -90 150
  make_wire -160 150 -190 150
  make_wire -160 100 -190 100
  make_wire -160 100 -90 100
  make_wire -160 20 -240 20
  make_wire -240 20 -240 230
  make_wire -240 230 -160 230
}


proc ICON_MUX_2X1 args {


  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -10} -name S
icon_term -type input -origin {-100 10} -name I0
icon_term -type input -origin {-100 30} -name I1
icon_term -type output -origin {100 -10} -name Y
icon_term -type inout -origin {100 30} -name a_Gnd
icon_term -type inout -origin {100 50} -name a_Vdd
icon_property -origin {-90 -10} -label S
icon_property -origin {-90 10} -label I0
icon_property -origin {-90 30} -label I1
icon_property -origin {90 -10} -anchor e -label Y
icon_property -origin {90 30} -anchor e -label a_Gnd
icon_property -origin {90 50} -anchor e -label a_Vdd
icon_property -origin {-90 -60} -label {$name}
icon_property -origin {-90 -40} -label MUX_2X1
  icon_line -100 -50 100 -50 100 70 -100 70 -100 -50
icon_property -origin {-90 80} -label {example_param=$example_param}
  icon_property -origin {-90 140} -type user -name name -default x
  icon_property -origin {-90 160} -type user -name example_param -default 1.0


}


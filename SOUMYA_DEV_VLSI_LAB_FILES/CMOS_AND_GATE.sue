proc SCHEMATIC_CMOS_AND_GATE {} {
make inout -name a_Vdd -origin {-610 -400}
make inout -name a_Gnd -origin {-560 410}
make input -name in1 -origin {-800 -200}
make pmos4 -name M0 -origin {-680 -200}
make nmos4 -name M2 -origin {-650 130}
make nmos4 -name M3 -origin {-650 250}
make output -name Vout -origin {-340 60}
make pmos4 -name M4 -origin {-430 10}
make nmos4 -name M5 -origin {-430 110}
make pmos4 -name M1 -origin {-550 -140}
make input -name in2 -origin {-800 -140}
  make_wire -680 -240 -680 -320
  make_wire -610 -200 -680 -200
  make_wire -740 130 -710 130
  make_wire -650 130 -560 130
  make_wire -650 170 -650 210
  make_wire -650 250 -560 250
  make_wire -560 250 -560 130
  make_wire -490 10 -540 10
  make_wire -540 110 -490 110
  make_wire -430 60 -340 60
  make_wire -430 10 -380 10
  make_wire -380 110 -380 150
  make_wire -430 50 -430 60
  make_wire -430 60 -430 70
  make_wire -540 10 -540 60
  make_wire -540 60 -540 110
  make_wire -430 110 -380 110
  make_wire -430 150 -380 150
  make_wire -380 -30 -380 10
  make_wire -430 -30 -380 -30
  make_wire -540 60 -650 60
  make_wire -430 -200 -430 -30
  make_wire -650 370 -560 370
  make_wire -430 370 -560 370
  make_wire -650 290 -650 370
  make_wire -430 150 -430 370
  make_wire -550 -100 -550 10
  make_wire -680 -320 -610 -320
  make_wire -610 -320 -550 -320
  make_wire -740 130 -740 -200
  make_wire -740 -200 -800 -200
  make_wire -680 10 -680 -160
  make_wire -680 10 -650 10
  make_wire -650 10 -550 10
  make_wire -610 -400 -610 -320
  make_wire -610 -320 -610 -200
  make_wire -550 -320 -550 -200
  make_wire -550 -200 -550 -180
  make_wire -650 10 -650 60
  make_wire -650 60 -650 90
  make_wire -560 250 -560 370
  make_wire -560 370 -560 410
  make_wire -770 -140 -770 250
  make_wire -770 250 -710 250
  make_wire -770 -140 -800 -140
  make_wire -770 -140 -610 -140
  make_wire -550 -140 -500 -140
  make_wire -500 -140 -500 -200
  make_wire -500 -200 -550 -200
  make_wire -500 -200 -430 -200
}

proc ICON_CMOS_AND_GATE args {



  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -10} -name in1
icon_term -type input -origin {-100 10} -name in2
icon_term -type output -origin {100 -10} -name Vout
icon_term -type inout -origin {100 30} -name a_Vdd
icon_term -type inout -origin {100 50} -name a_Gnd
icon_property -origin {-90 -10} -label in1
icon_property -origin {-90 10} -label in2
icon_property -origin {90 -10} -anchor e -label Vout
icon_property -origin {90 30} -anchor e -label a_Vdd
icon_property -origin {90 50} -anchor e -label a_Gnd
icon_property -origin {-90 -60} -label {$name}
icon_property -origin {-90 -40} -label CMOS_AND_GATE
  icon_line -100 -50 100 -50 100 70 -100 70 -100 -50
icon_property -origin {-90 80} -label {example_param=$example_param}
  icon_property -origin {-90 140} -type user -name name -default x
  icon_property -origin {-90 160} -type user -name example_param -default 1.0



}


proc ICON_CMOS_4X1_MUX args {

  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -40} -name in3
icon_term -type input -origin {-100 -20} -name in4
icon_term -type input -origin {-100 0} -name s0
icon_term -type input -origin {-100 20} -name s1
icon_term -type input -origin {-100 40} -name in0
icon_term -type input -origin {-100 60} -name in1
icon_term -type output -origin {100 -40} -name Y
icon_term -type output -origin {100 -20} -name Y
icon_term -type output -origin {100 0} -name Y
icon_term -type output -origin {100 20} -name Out
icon_term -type inout -origin {100 60} -name a_Gnd
icon_term -type inout -origin {100 80} -name a_Vdd
icon_property -origin {-90 -40} -label in3
icon_property -origin {-90 -20} -label in4
icon_property -origin {-90 0} -label s0
icon_property -origin {-90 20} -label s1
icon_property -origin {-90 40} -label in0
icon_property -origin {-90 60} -label in1
icon_property -origin {90 -40} -anchor e -label Y
icon_property -origin {90 -20} -anchor e -label Y
icon_property -origin {90 0} -anchor e -label Y
icon_property -origin {90 20} -anchor e -label Out
icon_property -origin {90 60} -anchor e -label a_Gnd
icon_property -origin {90 80} -anchor e -label a_Vdd
icon_property -origin {-90 -90} -label {$name}
icon_property -origin {-90 -70} -label CMOS_4X1_MUX
  icon_line -100 -80 100 -80 100 100 -100 100 -100 -80
icon_property -origin {-90 110} -label {example_param=$example_param}
  icon_property -origin {-90 170} -type user -name name -default x
  icon_property -origin {-90 190} -type user -name example_param -default 1.0

}


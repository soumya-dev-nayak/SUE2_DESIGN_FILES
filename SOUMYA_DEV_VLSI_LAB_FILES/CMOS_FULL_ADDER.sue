proc ICON_CMOS_FULL_ADDER args {

  icon_setup $args {{origin {0 0}} {orient R0} {name x} {example_param 1.0}}
icon_term -type input -origin {-100 -20} -name A
icon_term -type input -origin {-100 0} -name B
icon_term -type input -origin {-100 20} -name Cin
icon_term -type output -origin {100 -20} -name Sout
icon_term -type output -origin {100 0} -name Cout
icon_term -type inout -origin {100 40} -name a_Vdd
icon_term -type inout -origin {100 60} -name a_Gnd
icon_property -origin {-90 -20} -label A
icon_property -origin {-90 0} -label B
icon_property -origin {-90 20} -label Cin
icon_property -origin {90 -20} -anchor e -label Sout
icon_property -origin {90 0} -anchor e -label Cout
icon_property -origin {90 40} -anchor e -label a_Vdd
icon_property -origin {90 60} -anchor e -label a_Gnd
icon_property -origin {-90 -70} -label {$name}
icon_property -origin {-90 -50} -label CMOS_FULL_ADDER
  icon_line -100 -60 100 -60 100 80 -100 80 -100 -60
icon_property -origin {-90 90} -label {example_param=$example_param}
  icon_property -origin {-90 150} -type user -name name -default x
  icon_property -origin {-90 170} -type user -name example_param -default 1.0

}

